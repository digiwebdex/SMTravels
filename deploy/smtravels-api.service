[Unit]
Description=SMTravels API (Express/Prisma) — bare Node, 127.0.0.1:4030
After=network.target postgresql.service
Wants=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/SMTravels/backend
EnvironmentFile=/var/www/SMTravels/.env.production
# >>> ADJUST entrypoint to your build output (dist/main.js | dist/server.js | dist/index.js) <<<
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
MemoryMax=512M
MemoryHigh=448M
OOMPolicy=stop
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smtravels-api
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/SMTravels/uploads /var/www/SMTravels/backups
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
