# ── SM Travels API — environment ─────────────────────────────────────────────
# Copy this file to `.env` for LOCAL development.
# On the server the real values live in /var/www/SMTravels/.env.production
# (loaded by the systemd unit smtravels-api.service).

NODE_ENV=development
# MUST stay 127.0.0.1 — the server firewall assumes localhost-only. NEVER 0.0.0.0.
HOST=127.0.0.1
PORT=4030

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# LOCAL dev: run YOUR OWN Postgres (see DEPLOYMENT.md "Local backend dev").
# Do NOT point this at the production database.
DATABASE_URL=postgresql://smtravels_user:devpassword@localhost:5432/smtravels_db?schema=public

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me-too

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://smtravels.digiwebdex.com

# ── Integrations (placeholders — NOT wired up yet) ───────────────────────────
# SMTP (transactional email)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="SM Travels <noreply@smtravels.digiwebdex.com>"

# BulkSMSBD (SMS)
# BULKSMSBD_API_KEY=
# BULKSMSBD_SENDER_ID=

# Wasender (WhatsApp)
# WASENDER_API_URL=
# WASENDER_API_KEY=

# bKash (payment)
# BKASH_BASE_URL=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=

# Nagad (payment)
# NAGAD_BASE_URL=
# NAGAD_MERCHANT_ID=
# NAGAD_MERCHANT_PRIVATE_KEY=
# NAGAD_PG_PUBLIC_KEY=

# SSLCommerz (payment gateway)
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_IS_LIVE=false
