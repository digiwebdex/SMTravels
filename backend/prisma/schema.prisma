enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

// ─── ORG & IDENTITY ─────────────────────────────────────────────────────────
model Company {
  id               String   @id @default(cuid())
  name             String
  legalName        String?
  registrationNo   String?
  tin              String?
  address          String?
  phone            String?
  email            String?
  website          String?
  logoUrl          String?
  primaryColor     String?  @default("#0E6BB8")
  defaultCurrency  Currency @default(BDT)
  defaultLanguage  String   @default("en")
  timezone         String   @default("Asia/Dhaka")
  fiscalYearStart  Int      @default(1) // month 1-12
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  branches Branch[]
  settings Setting[]
}

model Branch {
  id        String    @id @default(cuid())
  companyId String
  code      String // e.g. DHK, CTG — used in document numbers
  name      String
  city      String
  address   String?
  phone     String?
  mobile    String?
  email     String?
  hours     String?
  mapUrl    String?
  isHq      Boolean   @default(false)
  status    String    @default("active")
  managerId String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  manager User?   @relation("BranchManager", fields: [managerId], references: [id], onDelete: Restrict)

  users     User[]     @relation("UserBranch")
  customers Customer[]
  bookings  Booking[]
  invoices  Invoice[]
  leads     Lead[]
  payments  Payment[]
  refunds   Refund[]
  expenses  Expense[]
  incomes   Income[]
  employees Employee[]
  hrHolidays HrHoliday[]

  @@index([companyId])
  @@index([managerId])
}

model User {
  id           String    @id @default(cuid())
  branchId     String?
  email        String
  phone        String?
  name         String
  passwordHash String
  role         UserRole  @default(STAFF) // drives UI affordances; RBAC roles are authoritative
  status       String    @default("active")
  avatarUrl    String?
  employeeId   String?
  department   String?
  // per-role profile PII (ciphertext + blind index + key version)
  nid          String?
  nidHash      String?
  piiKeyId     Int?
  lastActiveAt DateTime? @db.Timestamptz(6)
  twoFactor    Boolean   @default(false)
  failedLoginCount Int   @default(0)
  lockedUntil  DateTime? @db.Timestamptz(6)
  lastLoginAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  branch          Branch?          @relation("UserBranch", fields: [branchId], references: [id], onDelete: Restrict)
  managedBranches Branch[]         @relation("BranchManager")
  roles           UserRoleLink[]
  agent           Agent?
  supplier        Supplier?
  customer        Customer?
  employeeProfile Employee?         @relation("EmployeeUser")

  leadsAssigned     Lead[]              @relation("LeadAssignee")
  tasksAssigned     Task[]              @relation("TaskAssignee")
  bookingsStaffed   Booking[]           @relation("BookingStaff")
  leadActivities    LeadActivity[]
  followUps         FollowUp[]
  callLogs          CallLog[]
  notesAuthored     Note[]
  stageEvents       BookingStageEvent[]
  bookingActivities BookingActivity[]
  notifications     Notification[]
  authChallenges    AuthChallenge[]
  refreshTokens     RefreshToken[]
  hrEmployeesCreated Employee[]         @relation("EmployeeCreatedBy")
  hrEmployeesUpdated Employee[]         @relation("EmployeeUpdatedBy")
  hrEmployeesDeleted Employee[]         @relation("EmployeeDeletedBy")

  @@index([branchId])
  @@index([role])
}

enum ChallengeType {
  PASSWORD_RESET_OTP
}

model AuthChallenge {
  id         String        @id @default(cuid())
  userId     String
  type       ChallengeType
  codeHash   String
  expiresAt  DateTime      @db.Timestamptz(6)
  attempts   Int           @default(0)
  consumedAt DateTime?     @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // matches a UserRole enum value for the default roles
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  users       UserRoleLink[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "bookings.view", "invoices.manage"
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  access       String @default("full") // full | view | none

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleLink {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ─── CRM ────────────────────────────────────────────────────────────────────
model Customer {
  id           String       @id @default(cuid())
  branchId     String
  userId       String?      @unique
  agentId      String?
  type         CustomerType @default(INDIVIDUAL)
  name         String
  phone        String
  email        String?
  // PII (ciphertext + blind index)
  nid          String?
  nidHash      String?
  passportNo   String?
  passportHash String?
  piiKeyId     Int?
  dob          DateTime?    @db.Date
  addressLine  String?
  district     String?
  division     String?
  country      String?      @default("Bangladesh")
  rating       String? // e.g. "Trusted Client"
  createdById  String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?    @db.Timestamptz(6)

  branch    Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user      User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  agent     Agent?           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  corporate CorporateClient?
  bookings  Booking[]
  invoices  Invoice[]
  leads     Lead[]
  notes     Note[]
  documents Document[]

  @@index([branchId, createdAt])
  @@index([agentId])
  @@index([userId])
}

model CorporateClient {
  id            String    @id @default(cuid())
  customerId    String    @unique
  companyName   String
  contactPerson String?
  tradeLicense  String?
  tin           String?
  address       String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Lead {
  id              String       @id @default(cuid())
  branchId        String
  name            String
  phone           String
  email           String?
  source          String?
  serviceInterest ServiceType?
  quantity        Int?
  interest        LeadInterest @default(MEDIUM)
  stage           LeadStage    @default(NEW)
  assignedToId    String?
  agentId         String?
  customerId      String? // set when converted
  createdById     String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?    @db.Timestamptz(6)

  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedTo User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  agent      Agent?         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  activities LeadActivity[]
  followUps  FollowUp[]
  callLogs   CallLog[]
  notes      Note[]
  tasks      Task[]

  @@index([branchId, stage, assignedToId])
  @@index([agentId])
  @@index([customerId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  note      String?
  actorId   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([actorId])
}

model FollowUp {
  id           String    @id @default(cuid())
  leadId       String?
  customerId   String?
  assignedToId String?
  dueAt        DateTime  @db.Timestamptz(6)
  note         String?
  done         Boolean   @default(false)
  createdById  String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  lead       Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation(fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([assignedToId, done, dueAt])
}

model CallLog {
  id         String   @id @default(cuid())
  leadId     String?
  customerId String?
  direction  String // inbound | outbound
  durationSec Int?
  note       String?
  byId       String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  by   User? @relation(fields: [byId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([byId])
}

model Task {
  id               String       @id @default(cuid())
  title            String
  description      String?
  assigneeId       String?
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(TODO)
  category         String?
  tags             String[]
  dueAt            DateTime?    @db.Timestamptz(6)
  commentsCount    Int          @default(0)
  relatedBookingId String?
  relatedLeadId    String?
  createdById      String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?    @db.Timestamptz(6)

  assignee       User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  relatedBooking Booking? @relation(fields: [relatedBookingId], references: [id], onDelete: SetNull)
  relatedLead    Lead?    @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueAt])
  @@index([relatedBookingId])
  @@index([relatedLeadId])
}

model Note {
  id         String   @id @default(cuid())
  body       String
  leadId     String?
  customerId String?
  bookingId  String?
  authorId   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author   User?     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([customerId])
  @@index([bookingId])
}

// ─── CATALOG ────────────────────────────────────────────────────────────────
model Service {
  id                   String      @id @default(cuid())
  key                  String      @unique // hajj, umrah, visa, air_ticket, manpower, tour, hotel
  type                 ServiceType
  name                 String
  category             String?
  description          String?
  icon                 String?
  color                String?
  defaultCurrency      Currency    @default(BDT)
  refPrefix            String?
  maxGroupSize         Int?
  minLeadTimeDays      Int?
  showOnWebsite        Boolean     @default(true)
  allowDirectBooking   Boolean     @default(true)
  requireApproval      Boolean     @default(false)
  enableAgentCommission Boolean    @default(true)
  active               Boolean     @default(true)
  featured             Boolean     @default(false)
  createdAt            DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?   @db.Timestamptz(6)

  packages Package[]

  @@index([type])
}

model Package {
  id             String        @id @default(cuid())
  code           String // PKG-001
  slug           String
  serviceId      String?
  type           ServiceType
  name           String
  season         String?
  departure      String? // free-text period label
  duration       String?
  status         PackageStatus @default(DRAFT)
  basePrice      Decimal       @db.Decimal(18, 4)
  originalPrice  Decimal?      @db.Decimal(18, 4)
  currency       Currency      @default(BDT)
  exchangeRate   Decimal       @default(1) @db.Decimal(18, 8)
  baseAmount     Decimal       @db.Decimal(18, 4)
  totalSeats     Int           @default(0)
  availableSeats Int           @default(0)
  rating         Decimal?      @db.Decimal(3, 2)
  bookingsCount  Int           @default(0)
  revenue        Decimal       @default(0) @db.Decimal(18, 4)
  image          String?
  images         String[]
  shortDesc      String?
  longDesc       String?
  featured       Boolean       @default(false)
  hotels         Json? // nested hotel entries (display config)
  flights        Json? // nested flight entries (display config)
  createdById    String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?     @db.Timestamptz(6)

  service      Service?              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  pricingTiers PackagePricing[]
  itinerary    PackageItinerary[]
  inclusions   PackageInclusion[]
  availability PackageAvailability[]
  bookings     Booking[]

  @@index([serviceId])
  @@index([type, status])
}

model PackagePricing {
  id            String   @id @default(cuid())
  packageId     String
  label         String // Economy | Standard | Premium | VIP (per person)
  price         Decimal  @db.Decimal(18, 4)
  originalPrice Decimal? @db.Decimal(18, 4)
  currency      Currency @default(BDT)
  exchangeRate  Decimal  @default(1) @db.Decimal(18, 8)
  baseAmount    Decimal  @db.Decimal(18, 4)
  seats         Int      @default(0)
  occupied      Int      @default(0)
  sortOrder     Int      @default(0)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model PackageItinerary {
  id        String   @id @default(cuid())
  packageId String
  day       Int
  title     String
  description String?
  activities String[]
  hotel     String?
  breakfast Boolean  @default(false)
  lunch     Boolean  @default(false)
  dinner    Boolean  @default(false)
  transport String?

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model PackageInclusion {
  id        String  @id @default(cuid())
  packageId String
  kind      String // include | exclude
  text      String
  sortOrder Int     @default(0)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model PackageAvailability {
  id            String   @id @default(cuid())
  packageId     String
  departureDate DateTime @db.Date
  totalSeats    Int      @default(0)
  soldSeats     Int      @default(0)
  status        String   @default("open")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, departureDate])
  @@index([departureDate])
}

// ─── BOOKINGS ───────────────────────────────────────────────────────────────
model Booking {
  id             String        @id @default(cuid())
  bookingNo      String? // allocated at confirmation; null while DRAFT
  branchId       String
  customerId     String?
  packageId      String?
  serviceType    ServiceType
  status         BookingStatus @default(DRAFT)
  currentStep    Int           @default(0) // wizard resume position for DRAFT
  wizardData     Json? // partial per-step data captured while DRAFT
  assignedStaffId String?
  agentId        String?
  source         String?
  // money
  amount         Decimal       @db.Decimal(18, 4)
  currency       Currency      @default(BDT)
  exchangeRate   Decimal       @default(1) @db.Decimal(18, 8)
  baseAmount     Decimal       @db.Decimal(18, 4)
  paidAmount     Decimal       @default(0) @db.Decimal(18, 4)
  discountType   String?
  discountValue  Decimal?      @db.Decimal(18, 4)
  discountApprovedById String?
  travelersCount Int           @default(1)
  departureDate  DateTime?     @db.Date
  returnDate     DateTime?     @db.Date
  notes          String?
  createdById    String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?     @db.Timestamptz(6)

  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package       Package?  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  assignedStaff User?     @relation("BookingStaff", fields: [assignedStaffId], references: [id], onDelete: Restrict)
  agent         Agent?    @relation(fields: [agentId], references: [id], onDelete: Restrict)

  hajj      HajjBooking?
  umrah     UmrahBooking?
  visa      VisaBooking?
  airTicket AirTicketBooking?
  hotel     HotelBooking?
  manpower  ManpowerBooking?
  tour      TourBooking?

  travelers   Traveler[]
  documents   Document[]
  charges     BookingCharge[]
  stageEvents BookingStageEvent[]
  activities  BookingActivity[]
  invoices    Invoice[]
  installmentPlans InstallmentPlan[]
  noteEntries Note[]
  tasks       Task[]
  commissions AgentCommission[]
  bookingRequests BookingRequest[]

  @@index([branchId, createdAt])
  @@index([branchId, serviceType, status])
  @@index([agentId, createdAt])
  @@index([customerId, createdAt])
  @@index([packageId])
  @@index([assignedStaffId])
}

model HajjBooking {
  id           String       @id @default(cuid())
  bookingId    String       @unique
  packageTier  String?
  season       String?
  groupAssign  String?
  departureDate DateTime?   @db.Date
  returnDate   DateTime?    @db.Date
  roomType     String?
  transport    String?
  hotelMakkah  String?
  hotelMadinah String?
  daysMakkah   Int?
  daysMadinah  Int?
  mahramRequired Boolean    @default(false)
  specialRequests String?
  stageStatus  StageStatus  @default(PENDING)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model UmrahBooking {
  id           String      @id @default(cuid())
  bookingId    String      @unique
  packageTier  String?
  season       String?
  departureDate DateTime?  @db.Date
  returnDate   DateTime?   @db.Date
  roomType     String?
  transport    String?
  hotelMakkah  String?
  hotelMadinah String?
  daysMakkah   Int?
  daysMadinah  Int?
  mahramRequired Boolean   @default(false)
  specialRequests String?
  stageStatus  StageStatus @default(PENDING)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model VisaBooking {
  id              String      @id @default(cuid())
  bookingId       String      @unique
  destinationCountry String
  visaType        String
  processingSpeed String?
  passportCount   Int         @default(1)
  purpose         String?
  visaNumber      String?
  visaExpiry      DateTime?   @db.Date
  stageStatus     StageStatus @default(PENDING)
  notes           String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model AirTicketBooking {
  id           String    @id @default(cuid())
  bookingId    String    @unique
  airline      String?
  pnr          String?
  journeyType  String?
  origin       String?
  destination  String?
  cabinClass   String?
  departAt     DateTime? @db.Timestamptz(6)
  returnAt     DateTime? @db.Timestamptz(6)
  baseFare     Decimal?  @db.Decimal(18, 4)
  taxAmount    Decimal?  @db.Decimal(18, 4)
  agentMarkup  Decimal?  @db.Decimal(18, 4)
  fareType     String?
  baggage      String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model HotelBooking {
  id           String    @id @default(cuid())
  bookingId    String    @unique
  city         String?
  hotelName    String?
  starRating   Int?
  checkIn      DateTime? @db.Date
  checkOut     DateTime? @db.Date
  roomType     String?
  rooms        Int?
  guests       Int?
  boardBasis   String?
  confirmationNo String?
  distanceFromHaram String?
  specialRequests String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model ManpowerBooking {
  id            String      @id @default(cuid())
  bookingId     String      @unique
  workerCategory String?
  jobTitle      String?
  destinationCountry String?
  destinationCity String?
  employer      String?
  contractDuration String?
  monthlySalary String? // free text incl. foreign currency label
  accommodation String?
  stageStatus   StageStatus @default(PENDING)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model TourBooking {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  packageTier   String?
  tourType      String?
  destinations  String?
  duration      String?
  departureDate DateTime? @db.Date
  returnDate    DateTime? @db.Date
  travelers     Int?
  hotelCategory String?
  roomSharing   String?
  mealPlan      String?
  itineraryNote String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Traveler {
  id             String         @id @default(cuid())
  bookingId      String
  name           String
  dob            DateTime?      @db.Date
  gender         Gender?
  nationality    String?        @default("Bangladeshi")
  // PII (ciphertext + blind index)
  passportNo     String?
  passportHash   String?
  piiKeyId       Int?
  passportExpiry DateTime?      @db.Date
  phone          String?
  email          String?
  isPrimary      Boolean        @default(false)
  mahramRelation MahramRelation?
  mahramOfId     String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?      @db.Timestamptz(6)

  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mahramOf  Traveler?  @relation("Mahram", fields: [mahramOfId], references: [id], onDelete: SetNull)
  mahramFor Traveler[] @relation("Mahram")
  documents Document[]

  @@index([bookingId])
  @@index([mahramOfId])
}

model Document {
  id            String            @id @default(cuid())
  ownerType     DocumentOwnerType
  bookingId     String?
  travelerId    String?
  customerId    String?
  supplierId    String?
  type          DocumentType
  name          String
  filePath      String? // path on the server volume (files never in DB)
  mimeType      String?
  sizeBytes     Int?
  status        DocumentStatus    @default(MISSING)
  required      Boolean           @default(false)
  expiryAt      DateTime?         @db.Date
  tags          String[]
  // OCR metadata
  ocrStatus     String?
  ocrConfidence Int?
  ocrName       String?
  ocrPassportNo String? // ciphertext
  ocrPassportHash String?
  ocrDob        DateTime?         @db.Date
  ocrExpiry     DateTime?         @db.Date
  ocrNationality String?
  piiKeyId      Int?
  uploadedById  String?
  verifiedById  String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?         @db.Timestamptz(6)

  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  traveler Traveler? @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([status, expiryAt])
  @@index([ownerType, bookingId])
  @@index([travelerId])
  @@index([customerId])
  @@index([supplierId])
}

model BookingCharge {
  id           String   @id @default(cuid())
  bookingId    String
  label        String
  amount       Decimal  @db.Decimal(18, 4)
  currency     Currency @default(BDT)
  exchangeRate Decimal  @default(1) @db.Decimal(18, 8)
  baseAmount   Decimal  @db.Decimal(18, 4)
  kind         String? // fee | markup | tax | addon
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model BookingStageEvent {
  id        String      @id @default(cuid())
  bookingId String
  stage     String // e.g. "BMET", "GAMCA Medical", "Visa Under Review"
  status    StageStatus @default(PENDING)
  note      String?
  byId      String?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  by      User?   @relation(fields: [byId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}

model BookingActivity {
  id        String   @id @default(cuid())
  bookingId String
  actorId   String?
  action    String
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}

// ─── FINANCE ────────────────────────────────────────────────────────────────
model Invoice {
  id           String        @id @default(cuid())
  invoiceNo    String? // gapless per branch/year, allocated at issue
  fiscalYear   Int
  branchId     String
  customerId   String
  bookingId    String?
  issueDate    DateTime?     @db.Date
  dueDate      DateTime?     @db.Date
  currency     Currency      @default(BDT)
  exchangeRate Decimal       @default(1) @db.Decimal(18, 8)
  subtotal     Decimal       @db.Decimal(18, 4)
  discountAmount Decimal     @default(0) @db.Decimal(18, 4)
  taxRate      Decimal       @default(0) @db.Decimal(9, 4)
  taxAmount    Decimal       @default(0) @db.Decimal(18, 4)
  total        Decimal       @db.Decimal(18, 4)
  baseAmount   Decimal       @db.Decimal(18, 4)
  paidAmount   Decimal       @default(0) @db.Decimal(18, 4)
  status       InvoiceStatus @default(DRAFT)
  notes        String?
  createdById  String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?     @db.Timestamptz(6) // only DRAFT invoices may be soft-deleted

  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  booking  Booking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]
  payments Payment[]
  refunds  Refund[]
  plan     InstallmentPlan?

  @@index([branchId, issueDate])
  @@index([customerId, issueDate])
  @@index([status, dueDate])
  @@index([bookingId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  qty         Int     @default(1)
  unitPrice   Decimal @db.Decimal(18, 4)
  amount      Decimal @db.Decimal(18, 4)
  bookingId   String?
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// IMMUTABLE LEDGER — append-only, no deletedAt; corrections via reversal.
model Payment {
  id           String           @id @default(cuid())
  paymentNo    String?
  direction    PaymentDirection
  branchId     String
  invoiceId    String?
  bookingId    String?
  customerId   String?
  supplierId   String?
  amount       Decimal          @db.Decimal(18, 4)
  currency     Currency         @default(BDT)
  exchangeRate Decimal          @default(1) @db.Decimal(18, 8)
  baseAmount   Decimal          @db.Decimal(18, 4)
  method       PaymentMethod
  gateway      String?
  reference    String?
  status       PaymentStatus    @default(CONFIRMED)
  receivedById String?
  paidAt       DateTime         @default(now()) @db.Timestamptz(6)
  // reversal (immutability)
  isReversed   Boolean          @default(false)
  reversalOfId String?          @unique
  reversedById String?          @unique
  postedAt     DateTime         @default(now()) @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)

  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reversalOf Payment?  @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reverses   Payment?  @relation("PaymentReversal")
  receipt    Receipt?

  @@index([branchId, paidAt])
  @@index([invoiceId])
  @@index([customerId])
  @@index([supplierId])
}

model Receipt {
  id        String   @id @default(cuid())
  receiptNo String   @unique
  paymentId String   @unique
  branchId  String
  amount    Decimal  @db.Decimal(18, 4)
  currency  Currency @default(BDT)
  baseAmount Decimal @db.Decimal(18, 4)
  issuedById String?
  issuedAt  DateTime @default(now()) @db.Timestamptz(6)
  postedAt  DateTime @default(now()) @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([branchId, issuedAt])
}

model InstallmentPlan {
  id          String        @id @default(cuid())
  branchId    String
  invoiceId   String?       @unique
  bookingId   String?
  customerId  String
  total       Decimal       @db.Decimal(18, 4)
  currency    Currency      @default(BDT)
  baseAmount  Decimal       @db.Decimal(18, 4)
  downAmount  Decimal       @default(0) @db.Decimal(18, 4)
  status      String        @default("active")
  createdById String?
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?     @db.Timestamptz(6)

  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  installments Installment[]

  @@index([branchId])
  @@index([bookingId])
  @@index([customerId])
}

model Installment {
  id         String            @id @default(cuid())
  planId     String
  number     Int
  label      String?
  amountDue  Decimal           @db.Decimal(18, 4)
  currency   Currency          @default(BDT)
  baseAmount Decimal           @db.Decimal(18, 4)
  dueDate    DateTime          @db.Date
  paidDate   DateTime?         @db.Date
  paidAmount Decimal           @default(0) @db.Decimal(18, 4)
  status     InstallmentStatus @default(UPCOMING)

  plan InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, number])
  @@index([status, dueDate])
}

model Refund {
  id           String       @id @default(cuid())
  refundNo     String?
  branchId     String
  invoiceId    String?
  bookingId    String?
  customerId   String?
  reason       String?
  amount       Decimal      @db.Decimal(18, 4)
  currency     Currency     @default(BDT)
  exchangeRate Decimal      @default(1) @db.Decimal(18, 8)
  baseAmount   Decimal      @db.Decimal(18, 4)
  method       PaymentMethod?
  status       RefundStatus @default(PENDING)
  approvedById String?
  createdById  String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?    @db.Timestamptz(6)

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([branchId, createdAt])
  @@index([invoiceId])
}

model PromoCode {
  id          String      @id @default(cuid())
  code        String
  type        PromoType
  value       Decimal     @db.Decimal(18, 4)
  currency    Currency    @default(BDT) // meaningful for FLAT
  scope       String? // e.g. "Hajj Packages", "All Services"
  usedCount   Int         @default(0)
  usageLimit  Int?
  expiresAt   DateTime?   @db.Date
  status      PromoStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?   @db.Timestamptz(6)
}

model Account {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  parentId      String?
  accountClass  AccountClass
  role          AccountRole   @default(DETAIL)
  normalBalance NormalBalance
  currency      Currency      @default(BDT)
  balance       Decimal       @default(0) @db.Decimal(18, 4)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?     @db.Timestamptz(6)

  parent       Account?      @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Account[]     @relation("AccountTree")
  journalLines JournalLine[]
  bankAccounts BankAccount[]

  @@index([parentId])
  @@index([accountClass])
}

model BankAccount {
  id            String          @id @default(cuid())
  name          String
  bankName      String?
  type          BankAccountType @default(CURRENT)
  accountNumber String?
  iban          String?
  branchName    String?
  currency      Currency        @default(BDT)
  balance       Decimal         @default(0) @db.Decimal(18, 4)
  coaAccountId  String?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?       @db.Timestamptz(6)

  coaAccount Account? @relation(fields: [coaAccountId], references: [id], onDelete: Restrict)

  @@index([coaAccountId])
}

// IMMUTABLE LEDGER — no deletedAt.
model JournalEntry {
  id           String        @id @default(cuid())
  ref          String        @unique // gapless per branch/year
  fiscalYear   Int
  branchId     String
  date         DateTime      @db.Date
  description  String?
  currency     Currency      @default(BDT)
  status       JournalStatus @default(DRAFT)
  relatedType  String?
  relatedId    String?
  postedById   String?
  postedAt     DateTime?     @db.Timestamptz(6)
  // reversal
  isReversed   Boolean       @default(false)
  reversalOfId String?       @unique
  reversedById String?       @unique
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)

  reversalOf JournalEntry?  @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reverses   JournalEntry?  @relation("JournalReversal")
  lines      JournalLine[]

  @@index([branchId, date])
  @@index([status])
}

// IMMUTABLE LEDGER — no deletedAt. Balance (Σdebit=Σcredit) enforced by a
// deferred DB constraint trigger (raw-SQL migration) + service pre-check.
model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  debit     Decimal @default(0) @db.Decimal(18, 4)
  credit    Decimal @default(0) @db.Decimal(18, 4)
  narration String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
}

model Expense {
  id           String        @id @default(cuid())
  ref          String?
  branchId     String
  category     String
  description  String?
  vendorName   String?
  supplierId   String?
  accountId    String?
  amount       Decimal       @db.Decimal(18, 4)
  currency     Currency      @default(BDT)
  exchangeRate Decimal       @default(1) @db.Decimal(18, 8)
  baseAmount   Decimal       @db.Decimal(18, 4)
  method       PaymentMethod?
  status       ExpenseStatus @default(PENDING)
  date         DateTime      @db.Date
  createdById  String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?     @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, date])
  @@index([category])
}

model Income {
  id           String        @id @default(cuid())
  ref          String?
  branchId     String
  category     String
  description  String?
  payerName    String?
  accountId    String?
  amount       Decimal       @db.Decimal(18, 4)
  currency     Currency      @default(BDT)
  exchangeRate Decimal       @default(1) @db.Decimal(18, 8)
  baseAmount   Decimal       @db.Decimal(18, 4)
  method       PaymentMethod?
  status       IncomeStatus  @default(PENDING)
  date         DateTime      @db.Date
  createdById  String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?     @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, date])
  @@index([category])
}

// SupplierPayable = payable SCHEDULE (mirror of InstallmentPlan), not a movement.
model SupplierPayable {
  id                String        @id @default(cuid())
  branchId          String
  supplierId        String
  supplierInvoiceId String?
  amount            Decimal       @db.Decimal(18, 4)
  currency          Currency      @default(BDT)
  exchangeRate      Decimal       @default(1) @db.Decimal(18, 8)
  baseAmount        Decimal       @db.Decimal(18, 4)
  paidAmount        Decimal       @default(0) @db.Decimal(18, 4)
  dueDate           DateTime?     @db.Date
  status            PayableStatus @default(PENDING)
  createdById       String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?     @db.Timestamptz(6)

  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierInvoice SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)

  @@index([branchId, status, dueDate])
  @@index([supplierId])
}

// ─── AGENTS & SUPPLIERS ─────────────────────────────────────────────────────
model Agent {
  id            String    @id @default(cuid())
  agentCode     String
  userId        String?   @unique
  branchId      String?
  parentAgentId String?
  name          String
  phone         String?
  email         String?
  nid           String?
  nidHash       String?
  piiKeyId      Int?
  tradeLicense  String?
  tier          AgentTier @default(SILVER)
  commissionRate Decimal  @default(0) @db.Decimal(9, 4)
  bankName      String?
  accountNo     String?
  bankBranch    String?
  bkashNo       String?
  nagadNo       String?
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  user        User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  parentAgent Agent?            @relation("AgentHierarchy", fields: [parentAgentId], references: [id], onDelete: Restrict)
  subAgents   Agent[]           @relation("AgentHierarchy")
  wallet      AgentWallet?
  commissions AgentCommission[]
  customers   Customer[]
  leads       Lead[]
  bookings    Booking[]

  @@index([parentAgentId])
  @@index([branchId])
}

model CommissionTier {
  id          String    @id @default(cuid())
  tier        AgentTier @unique
  rate        Decimal   @db.Decimal(9, 4)
  minBookings Int       @default(0)
  maxBookings Int?
  active      Boolean   @default(true)
}

model AgentCommission {
  id          String           @id @default(cuid())
  agentId     String
  bookingId   String?
  period      String? // e.g. "2026-07" for monthly rollups
  grossAmount Decimal          @db.Decimal(18, 4)
  rate        Decimal          @db.Decimal(9, 4)
  amount      Decimal          @db.Decimal(18, 4)
  currency    Currency         @default(BDT)
  baseAmount  Decimal          @db.Decimal(18, 4)
  isOverride  Boolean          @default(false) // 1% sub-agent override
  status      CommissionStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?        @db.Timestamptz(6)

  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([agentId, period])
  @@index([bookingId])
}

model AgentWallet {
  id           String   @id @default(cuid())
  agentId      String   @unique
  balance      Decimal  @default(0) @db.Decimal(18, 4)
  currency     Currency @default(BDT)
  lastCreditAt DateTime? @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  agent        Agent             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]
}

// IMMUTABLE LEDGER — append-only, no deletedAt.
model WalletTransaction {
  id           String        @id @default(cuid())
  walletId     String
  type         WalletTxnType
  description  String?
  amount       Decimal       @db.Decimal(18, 4)
  currency     Currency      @default(BDT)
  baseAmount   Decimal       @db.Decimal(18, 4)
  method       String?
  reference    String?
  relatedBookingId String?
  isReversed   Boolean       @default(false)
  reversalOfId String?       @unique
  reversedById String?       @unique
  postedAt     DateTime      @default(now()) @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)

  wallet     AgentWallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  reversalOf WalletTransaction? @relation("WalletReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reverses   WalletTransaction? @relation("WalletReversal")

  @@index([walletId, postedAt])
}

model Supplier {
