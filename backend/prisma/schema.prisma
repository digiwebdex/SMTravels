// ─── COMMS & SYSTEM ─────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  icon      String?
  color     String?
  type      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  authorId    String?
  audience    String?
  pinned      Boolean   @default(false)
  branchId    String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([pinned, createdAt])
}

model Conversation {
  id        String         @id @default(cuid())
  name      String?
  channel   MessageChannel @default(INTERNAL)
  isGroup   Boolean        @default(false)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)

  messages Message[]
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String?
  content        String
  status         String? // sent | delivered | read
  attachmentName String?
  attachmentSize Int?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model MessageTemplate {
  id        String          @id @default(cuid())
  channel   TemplateChannel
  name      String
  event     String?
  content   String?
  category  String?
  status    String          @default("active")
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @db.Timestamptz(6)

  @@index([channel])
  @@index([event, channel])
}

/** Queued outbound notifications (email / SMS / WhatsApp / in-app). */
model OutboundNotification {
  id           String          @id @default(cuid())
  channel      OutboundChannel
  event        String
  to           String
  subject      String?
  body         String
  templateId   String?
  userId       String?
  payload      Json?
  status       OutboundStatus  @default(PENDING)
  scheduledFor DateTime?       @db.Timestamptz(6)
  attempts     Int             @default(0)
  maxAttempts  Int             @default(5)
  nextRetryAt  DateTime?       @db.Timestamptz(6)
  lastError    String?
  providerId   String?
  sentAt       DateTime?       @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)

  @@index([status, nextRetryAt])
  @@index([status, scheduledFor])
  @@index([createdAt])
  @@index([event, channel])
  @@index([userId, createdAt])
}

model SupportTicket {
  id            String       @id @default(cuid())
  ticketNo      String
  subject       String
  requesterType String // customer | agent | supplier | staff
  requesterId   String?
  category      String?
  priority      TaskPriority @default(MEDIUM)
  status        TicketStatus @default(OPEN)
  assignedToId  String?
  branchId      String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?    @db.Timestamptz(6)

  messages TicketMessage[]

  @@index([status, priority])
  @@index([requesterType, requesterId])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  fromId     String?
  fromLabel  String?
  body       String
  attachment String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  module    String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([module, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String        @id @default(cuid())
  userId    String?
  ip        String?
  event     String
  resource  String?
  severity  AuditSeverity @default(INFO)
  detail    String?
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  @@index([resource, createdAt])
  @@index([userId, createdAt])
  @@index([severity])
}

model Setting {
  id        String   @id @default(cuid())
  companyId String
  key       String
  value     String?
  group     String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

// Gapless per-branch/year sequence counters (Invoice, Receipt, JournalEntry).
// Allocation uses SELECT ... FOR UPDATE inside the document's transaction.
model DocumentSequence {
  id        String @id @default(cuid())
  scope     String // INVOICE | RECEIPT | JOURNAL
  branchId  String
  year      Int
  lastValue Int    @default(0)

  @@unique([scope, branchId, year])
}

// ─── HR MODULE (Phase 1) — branch-scoped, no tenantId ───────────────────────

enum EmployeeLifecycle {
  DRAFT
  OFFERED
  JOINED
  PROBATION
  CONFIRMED
  TRANSFERRED
  RESIGNED
  TERMINATED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum HrDocType {
  OFFER_LETTER
  APPOINTMENT_LETTER
  CONTRACT
  PASSPORT
  NATIONAL_ID
  CERTIFICATE
  RESUME
  MEDICAL
  DRIVING_LICENSE
  OTHER
}

enum HrLeaveRequestStatus {
  DRAFT
  SUBMITTED
  MANAGER_APPROVED
  HR_APPROVED
  REJECTED
  CANCELLED
}

enum HrHolidayScope {
  NATIONAL
  COMPANY
  BRANCH
  DEPARTMENT
  OPTIONAL
}

enum HrAttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum HrCorrectionStatus {
  SUBMITTED
  MANAGER_APPROVED
  HR_APPROVED
  REJECTED
  CANCELLED
}

model HrDepartment {
  id          String    @id @default(cuid())
  name        String
  code        String?
  branchId    String? // null = company-wide
  description String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  createdById String?
  updatedById String?
  deletedById String?

  sections  HrSection[]
  employees Employee[]
  holidays  HrHoliday[]

  @@index([branchId])
  @@index([deletedAt])
}

model HrSection {
  id           String    @id @default(cuid())
  departmentId String
  name         String
  code         String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  createdById  String?
  updatedById  String?
  deletedById  String?

  department HrDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  teams      HrTeam[]
  employees  Employee[]

  @@index([departmentId])
  @@index([deletedAt])
}

model HrTeam {
  id          String    @id @default(cuid())
  sectionId   String
  name        String
  code        String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  createdById String?
  updatedById String?
  deletedById String?

  section   HrSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  employees Employee[]

  @@index([sectionId])
  @@index([deletedAt])
}

model HrDesignation {
  id          String    @id @default(cuid())
  name        String
  code        String?
  level       Int?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  createdById String?
  updatedById String?
  deletedById String?

  employees Employee[]

  @@index([deletedAt])
}

model Employee {
  id                   String            @id @default(cuid())
  employeeCode         String            @unique
  userId               String?           @unique
  branchId             String
  departmentId         String?
  sectionId            String?
  teamId               String?
  designationId        String?
  managerId            String?
  photoUrl             String?
  firstName            String
  lastName             String
  preferredName        String?
  gender               String?
  dateOfBirth          DateTime?         @db.Date
  bloodGroup           String?
  nationality          String?
  religion             String?
  maritalStatus        String?
  phone                String?
  email                String?
  emergencyContactName String?
  emergencyContactPhone String?
  permanentAddress     String?
  presentAddress       String?
  employmentType       EmploymentType    @default(FULL_TIME)
  joiningDate          DateTime?         @db.Date
  probationMonths      Int?
  confirmationDate     DateTime?         @db.Date
  status               EmployeeLifecycle @default(DRAFT)
  workLocation         String?
  salaryStructureRef   String?
  education            String?
  experience           String?
  skills               String?
  languages            String?
  notes                String?
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?         @db.Timestamptz(6)
  createdById          String?
  updatedById          String?
  deletedById          String?

  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user         User?          @relation("EmployeeUser", fields: [userId], references: [id], onDelete: Restrict)
  department   HrDepartment?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  section      HrSection?     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  team         HrTeam?        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  designation  HrDesignation? @relation(fields: [designationId], references: [id], onDelete: Restrict)
  manager      Employee?      @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  reports      Employee[]     @relation("EmployeeManager")
  createdBy    User?          @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?          @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy    User?          @relation("EmployeeDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  timeline     EmployeeTimelineEvent[]
  documents    HrEmployeeDocument[]
  leaveBalances HrLeaveBalance[]
  leaveRequests HrLeaveRequest[]
  attendance   HrAttendanceRecord[]
  corrections  HrAttendanceCorrection[]

  @@index([branchId])
  @@index([departmentId])
  @@index([status])
  @@index([deletedAt])
  @@index([managerId])
  @@index([joiningDate])
}

model EmployeeTimelineEvent {
  id          String   @id @default(cuid())
  employeeId  String
  eventType   String
  title       String
  detail      String?
  occurredAt  DateTime @default(now()) @db.Timestamptz(6)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, occurredAt])
}

model HrEmployeeDocument {
  id          String    @id @default(cuid())
  employeeId  String
  type        HrDocType
  title       String
  filePath    String
  mimeType    String?
  sizeBytes   Int?
  version     Int       @default(1)
  expiryDate  DateTime? @db.Date
  notes       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  createdById String?
  updatedById String?
  deletedById String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([type])
  @@index([expiryDate])
  @@index([deletedAt])
}

model HrLeaveType {
  id                   String    @id @default(cuid())
  name                 String
  code                 String    @unique
  paid                 Boolean   @default(true)
  openingBalance       Decimal   @default(0) @db.Decimal(8, 2)
  maxPerYear           Decimal?  @db.Decimal(8, 2)
  carryForward         Boolean   @default(false)
  maxCarryForward      Decimal?  @db.Decimal(8, 2)
  allowNegativeBalance Boolean   @default(false)
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime? @db.Timestamptz(6)
  createdById          String?
  updatedById          String?
  deletedById          String?

  balances  HrLeaveBalance[]
  requests  HrLeaveRequest[]

  @@index([deletedAt])
}

model HrLeaveBalance {
  id           String   @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  year         Int
  opening      Decimal  @default(0) @db.Decimal(8, 2)
  accrued      Decimal  @default(0) @db.Decimal(8, 2)
  used         Decimal  @default(0) @db.Decimal(8, 2)
  carried      Decimal  @default(0) @db.Decimal(8, 2)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  employee  Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType HrLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
}

model HrLeaveRequest {
  id              String               @id @default(cuid())
  employeeId      String
  leaveTypeId     String
  fromDate        DateTime             @db.Date
  toDate          DateTime             @db.Date
  days            Decimal              @db.Decimal(8, 2)
  reason          String?
  status          HrLeaveRequestStatus @default(DRAFT)
  managerId       String?
  managerNote     String?
  managerAt       DateTime?            @db.Timestamptz(6)
  hrApproverId    String?
  hrNote          String?
  hrAt            DateTime?            @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?            @db.Timestamptz(6)
  createdById     String?
  updatedById     String?
  deletedById     String?

  employee  Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType HrLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
  @@index([fromDate, toDate])
  @@index([deletedAt])
}

model HrHoliday {
  id           String         @id @default(cuid())
  name         String
  date         DateTime       @db.Date
  scope        HrHolidayScope @default(COMPANY)
  branchId     String?
  departmentId String?
  optional     Boolean        @default(false)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?      @db.Timestamptz(6)
  createdById  String?
  updatedById  String?
  deletedById  String?

  branch     Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department HrDepartment? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([branchId])
  @@index([deletedAt])
}

model HrAttendanceRecord {
  id           String              @id @default(cuid())
  employeeId   String
  date         DateTime            @db.Date
  clockIn      DateTime?           @db.Timestamptz(6)
  clockOut     DateTime?           @db.Timestamptz(6)
  status       HrAttendanceStatus  @default(PRESENT)
  note         String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?           @db.Timestamptz(6)
  createdById  String?
  updatedById  String?
  deletedById  String?

  employee    Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  corrections HrAttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
}

model HrAttendanceCorrection {
  id              String             @id @default(cuid())
  attendanceId    String
  employeeId      String
  requestedClockIn  DateTime?        @db.Timestamptz(6)
  requestedClockOut DateTime?        @db.Timestamptz(6)
  requestedStatus HrAttendanceStatus?
  reason          String?
  status          HrCorrectionStatus @default(SUBMITTED)
  managerId       String?
  managerNote     String?
  managerAt       DateTime?          @db.Timestamptz(6)
  hrApproverId    String?
  hrNote          String?
  hrAt            DateTime?          @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?          @db.Timestamptz(6)
  createdById     String?
  updatedById     String?
  deletedById     String?

  attendance HrAttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([deletedAt])
}
