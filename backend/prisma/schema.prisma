  supplierCode  String
  userId        String?        @unique
  name          String
  category      String?
  contactPerson String?
  phone         String?
  email         String?
  website       String?
  tradeLicense  String?
  tin           String?
  address       String?
  bankName      String?
  accountNo     String?
  routingNo     String?
  rating        Decimal?       @db.Decimal(3, 2)
  status        SupplierStatus @default(PENDING)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?      @db.Timestamptz(6)

  user            User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  services        SupplierService[]
  invoices        SupplierInvoice[]
  payables        SupplierPayable[]
  bookingRequests BookingRequest[]
  documents       Document[]
}

model SupplierService {
  id            String    @id @default(cuid())
  supplierId    String
  name          String
  category      String?
  price         Decimal?  @db.Decimal(18, 4)
  currency      Currency  @default(BDT)
  priceLabel    String? // original free-text price ("From ৳3,500/night/room")
  active        Boolean   @default(true)
  bookingsCount Int       @default(0)
  rating        Decimal?  @db.Decimal(3, 2)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierId])
}

model SupplierInvoice {
  id            String    @id @default(cuid())
  supplierId    String
  invoiceNo     String // the supplier's own number
  bookingRequestId String?
  description   String?
  amount        Decimal   @db.Decimal(18, 4)
  currency      Currency  @default(BDT)
  exchangeRate  Decimal   @default(1) @db.Decimal(18, 8)
  baseAmount    Decimal   @db.Decimal(18, 4)
  issueDate     DateTime? @db.Date
  dueDate       DateTime? @db.Date
  status        String    @default("pending")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  supplier       Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  bookingRequest BookingRequest?   @relation(fields: [bookingRequestId], references: [id], onDelete: Restrict)
  payables       SupplierPayable[]

  @@index([supplierId])
  @@index([bookingRequestId])
}

model BookingRequest {
  id          String               @id @default(cuid())
  requestNo   String
  supplierId  String
  bookingId   String?
  branchId    String?
  serviceLabel String?
  clientLabel String?
  property    String?
  dates       String?
  rooms       Int?
  nights      Int?
  amount      Decimal              @db.Decimal(18, 4)
  currency    Currency             @default(BDT)
  baseAmount  Decimal              @db.Decimal(18, 4)
  status      BookingRequestStatus @default(PENDING)
  deadline    DateTime?            @db.Timestamptz(6)
  notes       String?
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?            @db.Timestamptz(6)

  supplier        Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  booking         Booking?          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  supplierInvoices SupplierInvoice[]

  @@index([supplierId, status])
  @@index([bookingId])
}

// ─── CMS ────────────────────────────────────────────────────────────────────
model CmsPage {
