  DRAFT
  SCHEDULED
  ARCHIVED
}

enum BannerType {
  PROMO
  HERO
  SIDEBAR
  CTA
}

enum MenuLocation {
  MAIN_NAV
  FOOTER_NAV
  MOBILE_NAV
}

enum MediaType {
  IMAGE
  PDF
  DOC
}

enum MessageChannel {
  INTERNAL
  GROUP
  ANNOUNCEMENTS
  EMAIL
  SMS
  WHATSAPP
}

enum TemplateChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum OutboundChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum OutboundStatus {
  PENDING
  SCHEDULED
  PROCESSING
  SENT
  FAILED
