// ============================================================================
//  SM Travels International — Prisma schema (single-tenant)
//  Derived from the ERP/portal UI. See SCHEMA_DECISIONS.md for the rationale
//  and every UI ambiguity + assumption.
//
//  Conventions:
//   - Money: @db.Decimal(18,4); exchangeRate @db.Decimal(18,8); base = BDT.
//     Invariant baseAmount = amount * exchangeRate is enforced in the service
//     layer (BDT rows must have exchangeRate = 1).
//   - Timestamps: @db.Timestamptz(6), stored UTC (app renders Asia/Dhaka).
//   - Dates that are calendar dates (departure/expiry/dob/due) are @db.Date.
//   - Soft delete: deletedAt on business models — EXCEPT the immutable ledger
//     (JournalEntry, JournalLine, Payment, Receipt, WalletTransaction), which is
//     append-only; corrections are reversals.
//   - onDelete defaults to Restrict; Cascade only on fully-owned child rows
//     (justified in SCHEMA_DECISIONS.md).
//   - Partial unique indexes (WHERE deleted_at IS NULL), the journal-balance
//     constraint trigger, and gapless numbering live in raw-SQL migrations.
//   - PII (passport/NID) columns hold ciphertext (app-level AES-256-GCM); a
//     companion *Hash column is an HMAC blind index for exact-match lookup.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────
enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  BRANCH_MANAGER
  STAFF
  ACCOUNTANT
  SALES_EXECUTIVE
  VISA_EXECUTIVE
  HAJJ_EXECUTIVE
  UMRAH_EXECUTIVE
  AGENT
  SUPPLIER
  CUSTOMER
}

enum Currency {
  BDT
  USD
  SAR
}

enum ServiceType {
  HAJJ
  UMRAH
  VISA
  AIR_TICKET
  MANPOWER
  TOUR
  HOTEL
}

enum BookingStatus {
  DRAFT
  PENDING
  PROCESSING
  CONFIRMED
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  DONE
  NOT_APPLICABLE
}

enum Gender {
  MALE
  FEMALE
}

enum MahramRelation {
  HUSBAND
  FATHER
  BROTHER
  SON
  UNCLE
  OTHER
}

enum CustomerType {
  INDIVIDUAL
  CORPORATE
}

enum DocumentType {
  PASSPORT
  PHOTO
  VISA
  NID
  MEDICAL
  VACCINATION
  AIR_TICKET
  HOTEL
  INSURANCE
  CONTRACT
  LICENSE
  MAHRAM_CERT
  OTHER
}

enum DocumentStatus {
  MISSING
  UPLOADED
  PENDING
  VERIFIED
  EXPIRING
  EXPIRED
  FAILED
  NOT_REQUIRED
}

enum DocumentOwnerType {
  BOOKING
  TRAVELER
  CUSTOMER
  SUPPLIER
  COMPANY
}

enum PackageStatus {
  ACTIVE
  DRAFT
  ARCHIVED
  SUSPENDED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  BKASH
  NAGAD
  ROCKET
  CHEQUE
  CARD
  SSLCOMMERZ
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentStatus {
  PENDING   // customer-submitted NPSB proof awaiting staff verification
  CONFIRMED // verified or staff-recorded payment (receipt issued)
  FAILED    // rejected proof or gateway failure
  REVERSED  // original payment reversed via mirror entry
}

enum InstallmentStatus {
  UPCOMING
  DUE
  PAID
  OVERDUE
}

enum PayableStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

enum PromoType {
  FLAT
  PERCENT
}

enum PromoStatus {
  ACTIVE
  EXPIRED
}

enum AccountClass {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountRole {
  HEADER
  DETAIL
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum BankAccountType {
  CURRENT
  SAVINGS
  PETTY_CASH
  CASH
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum ExpenseStatus {
  PENDING
  PAID
}

enum IncomeStatus {
  PENDING
  CONFIRMED
}

enum LeadStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadInterest {
  HIGH
  MEDIUM
  LOW
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum AgentTier {
  SILVER
  GOLD
  PLATINUM
}

enum CommissionStatus {
